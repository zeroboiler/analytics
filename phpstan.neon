parameters:
    level: 9
    paths:
        - src/
    excludePaths:
        - tests/*
        - stubs/*
    bootstrapFiles:
        - stubs/laravel-helpers.php
    ignoreErrors:
        # config() returns mixed; overview command safely accesses known keys
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Binary operation "\." between .+ and mixed~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Parameter #1 .+ of function substr expects string, mixed given~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Argument of an invalid type mixed supplied for foreach~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Part .+ \(mixed\) of encapsed string cannot be cast to string~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        # ConfigRepository::get() returns mixed; safely used with known config keys
        - message: '~Parameter #3 .+ of class .+ constructor expects string, mixed given~'
          path: src/AnalyticsServiceProvider.php
        # Request::input() returns mixed; controller validates before use
        - message: '~Parameter \$name of class .+ constructor expects string, mixed given~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Parameter \$params of class .+ constructor expects array<string, mixed>, mixed given~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Cannot call method getKey\(\) on mixed~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Argument of an invalid type mixed supplied for foreach~'
          path: src/Http/Controllers/AnalyticsEventController.php
        # config() returns mixed; test command safely uses option() values
        - message: '~Cannot cast array\|bool\|float\|int\|string\|null to string~'
          path: src/Console/Commands/AnalyticsTestCommand.php
