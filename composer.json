{
    "name": "zeroboiler/analytics",
    "description": "Industry-standard SaaS analytics for Laravel \u2014 GA4, GTM, Meta Pixel, Plausible, PostHog",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "analytics",
        "ga4",
        "gtm",
        "meta-pixel",
        "plausible",
        "posthog",
        "tracking",
        "events",
        "gdpr",
        "consent",
        "ecommerce"
    ],
    "version": "4.5.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "zeroboiler/response": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0",
        "rector/rector": "^2.0",
        "illuminate/config": "^13.21",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ZeroBoiler\\Analytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroBoiler\\Analytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroBoiler\\Analytics\\AnalyticsServiceProvider"
            ],
            "aliases": {
                "Analytics": "ZeroBoiler\\Analytics\\Facades\\Analytics"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --min=80",
        "test:ci": "vendor/bin/pest --coverage --min=44",
        "pint": "vendor/bin/pint --test",
        "pint:fix": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "rector": "vendor/bin/rector --dry-run --no-progress-bar",
        "rector:fix": "vendor/bin/rector --no-progress-bar",
        "ci": [
            "@pint",
            "@phpstan",
            "@rector",
            "@test"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../response"
        }
    ]
}
