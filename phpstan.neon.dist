parameters:
    level: 9
    paths:
        - src/
    excludePaths:
        - tests/*
        - stubs/*
    bootstrapFiles:
        - stubs/laravel-helpers.php
    ignoreErrors:
        # config() returns mixed; overview command safely accesses known keys
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Binary operation "\." between .+ and mixed~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Parameter #1 .+ of function substr expects string, mixed given~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
          reportUnmatched: false
        - message: '~Argument of an invalid type mixed supplied for foreach~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        - message: '~Part .+ \(mixed\) of encapsed string cannot be cast to string~'
          path: src/Console/Commands/AnalyticsOverviewCommand.php
        # config() returns mixed; used with known keys throughout
        - message: '~Parameter .+ of class .+ constructor expects .+, mixed given~'
          path: src/AnalyticsServiceProvider.php
        # Request::input() returns mixed; controller validates before use
        - message: '~Parameter \$name of class .+ constructor expects string, mixed given~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Parameter \$params of class .+ constructor expects array<string, mixed>, mixed given~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Cannot call method getKey\(\) on mixed~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Argument of an invalid type mixed supplied for foreach~'
          path: src/Http/Controllers/AnalyticsEventController.php
        - message: '~Parameter #1 \$signals of method .+ expects array<string, string\|null>, array<mixed> given~'
          path: src/Http/Controllers/AnalyticsEventController.php
        # config() returns mixed; test command safely uses option() values
        - message: '~Cannot cast array\|bool\|float\|int\|string\|null to string~'
          path: src/Console/Commands/AnalyticsTestCommand.php
        # auth()->user() returns mixed to PHPStan via facade
        - message: '~Call to an undefined method .+Auth\\Factory::user\(\)~'
          path: src/Inertia/HandleInertiaAnalytics.php
        # Authenticatable::getKey() not in PHPStan's contract stubs
        - message: '~Call to an undefined method .+Auth\\Authenticatable::getKey\(\)~'
          path: src/Inertia/HandleInertiaAnalytics.php
        # EcommerceAnalyticsService: array<string, mixed> access returns mixed
        - message: '~Parameter .+ of class .+ constructor expects .+, mixed given~'
          path: src/Services/EcommerceAnalyticsService.php
        - message: '~Cannot cast mixed to (string|float|int)~'
          path: src/Services/EcommerceAnalyticsService.php
        - message: '~Method .+EcommerceAnalyticsService::formatItems\(\) should return array<int, .+ but returns array<string, .+~'
          path: src/Services/EcommerceAnalyticsService.php
        - message: '~Parameter #1 \$callback of function array_map expects~'
          path: src/Services/EcommerceAnalyticsService.php
        # EcommerceAnalyticsService: formatItems returns array<string,mixed> but events expect shaped arrays
        - message: '~Parameter \$items of class .+ constructor expects array<int, array\{.+\\}>, array<int, array<string, mixed>> given~'
          path: src/Services/EcommerceAnalyticsService.php
        # Http facade returns union type at static analysis level
        - message: '~Call to an undefined method .+PromiseInterface\|.*Response::(successful|status|body)\(\)~'
        # ServerSideTracker: dynamic class construction via new $class(...)
        - message: '~Method .+ServerSideTracker::buildAnalyticsEvent\(\) should return .+AnalyticsEvent but returns object~'
          path: src/Tracking/ServerSideTracker.php
        - message: '~Parameter #2 \$payload of method .+extractConstructorArgs\(\) expects array<string, mixed>, array<mixed, mixed> given~'
          path: src/Tracking/ServerSideTracker.php
        # RealTimeAggregationService: cache->get returns mixed
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Services/RealTimeAggregationService.php
        - message: '~Argument of an invalid type mixed supplied for foreach~'
          path: src/Services/RealTimeAggregationService.php
        # ABTestAnalyticsService: cache->get returns mixed
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Services/ABTestAnalyticsService.php
        # GeolocationEnricher: conditional class_exists usage
        - message: '~Call to an undefined method.+\$country~'
          path: src/Pipeline/GeolocationEnricher.php
        - message: '~Cannot access offset .+ on mixed~'
          path: src/Pipeline/GeolocationEnricher.php
